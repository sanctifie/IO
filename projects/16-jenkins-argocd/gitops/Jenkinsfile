// Projet 16 — pipeline CD (dépôt gitops-register-app) : met à jour le tag d'image et pousse. Argo CD fait le reste.
// Job paramétré (String Parameter IMAGE_TAG), "Trigger builds remotely" avec le jeton gitops-token.
pipeline {
    agent { label 'Jenkins-Agent' }
    environment {
        APP_NAME = "register-app-pipeline"
        GIT_REPO = "github.com/REMPLACER/gitops-register-app"
    }
    stages {
        stage('Cleanup Workspace') { steps { cleanWs() } }
        stage('Checkout from SCM') {
            steps { git branch: 'main', credentialsId: 'github', url: "https://${GIT_REPO}" }
        }
        stage('Update the Deployment Tags') {
            steps {
                sh '''
                  sed -i -E "s#(image: .*/${APP_NAME}):.*#\\1:${IMAGE_TAG}#" deployment.yaml
                  grep "image:" deployment.yaml
                '''
            }
        }
        stage('Push the changed deployment file to Git') {
            steps {
                sh '''
                  git config user.name  "Jenkins"
                  git config user.email "jenkins@exemple.com"
                  git add deployment.yaml
                  git commit -m "ci: register-app ${IMAGE_TAG}"
                '''
                withCredentials([gitUsernamePassword(credentialsId: 'github', gitToolName: 'Default')]) {
                    sh 'git push "https://${GIT_REPO}" HEAD:main'
                }
            }
        }
    }
}
