# Paramètres du backend S3, passés à l'init : terraform init -backend-config=tfstate.config
bucket       = "io-tfstate-PRENOM" # ← ton bucket d'état
key          = "terraform/staging/terraform.tfstate"
region       = "eu-west-3"
encrypt      = true
use_lockfile = true # verrou natif S3 (remplace la table DynamoDB "state-lock")
